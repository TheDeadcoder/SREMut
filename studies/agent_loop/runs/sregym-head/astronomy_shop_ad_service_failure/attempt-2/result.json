{
  "agent": {
    "commands": [
      "kubectl get pods -n astronomy-shop | grep -v Running; kubectl get events -n astronomy-shop --sort-by=.lastTimestamp | tail -15",
      "cd /tmp; kubectl get pods -n astronomy-shop; kubectl get deploy -n astronomy-shop; kubectl get cm -n astronomy-shop flagd-config -o yaml | head -80",
      "cd /tmp; kubectl get cm -n astronomy-shop flagd-config -o json | python3 -I -c \"\nimport json,sys\nd=json.load(sys.stdin)['data']\nfor k,v in d.items():\n  for n,f in json.loads(v)['flags'].items(): print(n,f['defaultVariant'])\"",
      "cd /tmp; kubectl get cm -n astronomy-shop flagd-config -o yaml | grep -E '^        \"|defaultVariant'",
      "cd /tmp; kubectl get cm -n astronomy-shop flagd-config -o json | sed 's/\"defaultVariant\\\\\": \\\\\"on\\\\\"/\"defaultVariant\\\\\": \\\\\"off\\\\\"/' > /tmp/cm.json; kubectl apply -f /tmp/cm.json 2>&1 | tail -2; kubectl get cm -n astronomy-shop flagd-config -o yaml | grep -B1 -A0 'defaultVariant\": \"on\"'; kubectl rollout restart deploy/flagd deploy/ad -n astronomy-shop"
    ],
    "exit_code": 0,

  "agent": {
    "commands": [
      "kubectl get pods -n astronomy-shop | grep -v Running; kubectl get events -n astronomy-shop --sort-by=.lastTimestamp | tail -15",
      "cd /tmp; kubectl get pods -n astronomy-shop; kubectl get deploy -n astronomy-shop; kubectl get cm -n astronomy-shop; kubectl get events -n astronomy-shop --sort-by=.lastTimestamp | grep -i -E \"warn|fail|backoff\" | tail",
      "kubectl get cm flagd-config -n astronomy-shop -o jsonpath='{.data}' | grep -o -E '\"[a-zA-Z]+\": \\{[^}]*\"defaultVariant\": \"[a-zA-Z0-9]+\"' | head -40; kubectl get cm flagd-config -n astronomy-shop -o yaml | grep -n -E 'defaultVariant'",
      "kubectl get cm flagd-config -n astronomy-shop -o yaml | sed -n 50,65p; kubectl logs deploy/ad -n astronomy-shop --tail=15",
      "cd /tmp; kubectl get cm flagd-config -n astronomy-shop -o json > cm.json\npython3 -I - <<'E'\nimport json\nc=json.load(open('/tmp/cm.json'))\nk=list(c['data'])[0]\nd=json.loads(c['data'][k])\nd['flags']['adHighCpu']['defaultVariant']='off'\nc['data'][k]=json.dumps(d,indent=2)\njson.dump(c,open('/tmp/cm2.json','w'))\nE\nkubectl replace -f cm2.json && kubectl rollout restart deploy/flagd deploy/ad -n astronomy-shop",
      "cd /tmp; kubectl get cm flagd-config -n astronomy-shop -o yaml > cm.yaml\nsed -i '52,59s/\"defaultVariant\": \"on\"/\"defaultVariant\": \"off\"/' cm.yaml\nkubectl replace -f cm.yaml && kubectl rollout restart deploy/flagd deploy/ad -n astronomy-shop\nkubectl get cm flagd-config -n astronomy-shop -o yaml | sed -n 52,59p"
    ],

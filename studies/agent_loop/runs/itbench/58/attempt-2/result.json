{
  "agent": {
    "alerts_given": "- HighKafkaConsumerLag (otel-collector-847fb8fc48-m4xtl)\n- KafkaConsumerGroupInactive (otel-collector-847fb8fc48-m4xtl)\n- NoRequestsReceived (accounting)\n- NoRequestsReceived (chatbot)\n- NoRequestsReceived (mcp)",
    "commands": [
      "kubectl -n otel-demo get pods -o wide | head -60",
      "cd /tmp; kubectl -n otel-demo get deploy | head -40; kubectl -n otel-demo logs deploy/otel-collector --tail=40; kubectl -n otel-demo get events --sort-by=.lastTimestamp | tail -15",
      "cd /tmp; kubectl -n otel-demo get deploy accounting -o yaml | grep -iE \"annotations|replicas|kubectl|managed|manager\" ; kubectl -n otel-demo get cm; kubectl -n otel-demo logs deploy/chatbot --tail=15 | cut -c1-300; kubectl -n otel-demo logs deploy/mcp --tail=15 | cut -c1-300",
      "cd /tmp; kubectl -n otel-demo scale deploy accounting --replicas=1; kubectl -n otel-demo get cm otel-collector -o yaml | grep -nE \"firepit|kafka|jaeger|endpoint|topic|group\" ",
      "cd /tmp; kubectl -n otel-demo logs deploy/otel-collector | grep -E \"warn|error\" | grep -v jaeger | cut -c1-400 | tail -8; kubectl -n otel-demo get svc",
      "cd /tmp; sleep 45; kubectl -n otel-demo get pods | grep -E \"accounting|chatbot|mcp\"; kubectl -n otel-demo logs deploy/accounting --tail=8 | cut -c1-250; kubectl -n otel-demo logs deploy/chatbot --since=2m | tail -5 | cut -c1-200",
      "cd /tmp; kubectl -n otel-demo get deploy load-generator -o yaml | grep -iE -A1 \"name: .*(USER|CHAT|MCP|AGENT)\" | head -30; kubectl -n otel-demo get deploy agent chatbot -o yaml | grep -iE -A1 \"mcp|AGENT_\" | head -20; kubectl -n otel-demo logs deploy/agent --tail=5 | cut -c1-250",
      "cd /tmp; for d in agent chatbot; do echo $d; kubectl -n otel-demo get deploy $d -o jsonpath='{range .spec.template.spec.containers[0].env[*]}{.name}={.value}{\"\\n\"}{end}' | grep -iE \"mcp|enabled\"; done; kubectl -n otel-demo rollout history deploy/agent; kubectl -n otel-demo get deploy agent -o jsonpath='{.metadata.managedFields[*].manager}'",
      "cd /tmp; helm -n otel-demo list 2>&1 | head; helm -n otel-demo get values $(helm -n otel-demo list -q | head -1) 2>&1 | grep -iE -B3 -A3 \"mcp|agent\" | head -40",
      "cd /tmp; kubectl -n otel-demo set env deploy/agent MCP_ENABLED=True && kubectl -n otel-demo rollout status deploy/agent --timeout=120s; sleep 60; kubectl -n otel-demo logs deploy/mcp --since=1m | tail -5 | cut -c1-200; kubectl -n otel-demo logs deploy/chatbot --since=1m | tail -3 | cut -c1-200; kubectl -n otel-demo logs deploy/agent --since=1m | grep -iE \"error|mcp\" | tail -5 | cut -c1-200"
    ],
    "exit_code": 0,

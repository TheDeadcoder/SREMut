    "commands": [
      "kubectl -n otel-demo get pods -o wide 2>&1 | head -50",
      "cd /tmp; kubectl -n otel-demo get deploy 2>&1 | grep -v \"1/1\"; kubectl -n otel-demo logs deploy/otel-collector --tail=30 2>&1; kubectl -n otel-demo get events --sort-by=.lastTimestamp 2>&1 | tail -15",
      "cd /tmp; kubectl -n otel-demo get deploy accounting -o yaml | head -40; kubectl -n otel-demo logs deploy/otel-collector 2>&1 | grep -iE \"error|warn\" | cut -c1-300 | sort | uniq -c | sort -rn | head",
      "cd /tmp; kubectl -n otel-demo logs deploy/chatbot --tail=15 2>&1|cut -c1-300; kubectl -n otel-demo logs deploy/mcp --tail=15 2>&1|cut -c1-300; kubectl -n otel-demo logs deploy/otel-collector 2>&1 | grep -m2 \"Exporting failed\" | grep -o '\"error\".*' | cut -c1-400",
      "cd /tmp; kubectl -n otel-demo get svc -o wide | grep -E \"10.96.162.221|NAME\"; kubectl -n otel-demo get endpoints | head -40",
      "cd /tmp; kubectl -n otel-demo scale deploy/accounting --replicas=1; kubectl -n otel-demo rollout status deploy/accounting --timeout=120s; kubectl -n otel-demo logs deploy/accounting --tail=10 | cut -c1-250; kubectl -n otel-demo get svc | grep -c .; kubectl -n otel-demo get deploy -o custom-columns=N:.metadata.name,R:.spec.replicas | grep -E \" 0\"",
      "cd /tmp; sleep 45; kubectl -n otel-demo logs deploy/accounting --tail=10 -c accounting | cut -c1-250; kubectl -n otel-demo get pod | grep -E \"accounting|chatbot|mcp\""

    "commands": [
      "kubectl -n otel-demo get pods -o wide | head -50; kubectl -n otel-demo get events --sort-by=.lastTimestamp | tail -20",
      "cd /tmp; kubectl -n otel-demo get hpa; kubectl -n otel-demo get pods | tail -n +50; kubectl get hpa -A | grep -v otel-demo; kubectl -n otel-demo logs deploy/accounting --tail=15",
      "cd /tmp; kubectl -n otel-demo logs deploy/frontend-proxy --tail=15; kubectl -n otel-demo logs deploy/frontend --tail=15; kubectl -n otel-demo get deploy -o custom-columns=N:.metadata.name,R:.spec.replicas,REQ:.spec.template.spec.containers[0].resources; kubectl -n otel-demo get hpa -A | grep -i kube-state; kubectl get hpa -A",
      "cd /tmp; kubectl get ns; kubectl get hpa,pods -A | grep -i -E \"kube-state|prometheus\"; kubectl -n otel-demo get cm,deploy flagd -o name | head; kubectl -n otel-demo get cm -o name",
      "cd /tmp; kubectl -n otel-demo logs deploy/frontend --tail=300 | grep -v '\"status_code\":200' | tail -8; kubectl -n otel-demo top pods 2>&1 | head -5",
      "cd /tmp; kubectl -n otel-demo get cm flagd-config -o yaml | grep -n -B2 -A8 '\"defaultVariant\"' | grep -E 'defaultVariant|^\\S*-\\s+\"[a-zA-Z]+\": \\{' | head -60; kubectl -n otel-demo get hpa ad fraud-detection kafka -o yaml | grep -A12 -E \"^  (metrics|behavior)\"|head -80",
      "cd /tmp; kubectl -n otel-demo get hpa ad fraud-detection kafka frontend -o yaml | grep -E \"^    name:|type:|averageUtilization|name: (cpu|memory)\"; kubectl -n otel-demo describe hpa fraud-detection | tail -15; kubectl -n otel-demo get deploy ad fraud-detection kafka frontend -o yaml | grep -E \"^    name:|annotations|last-applied\" | head",
      "cd /tmp; for h in ad fraud-detection kafka frontend image-provider; do kubectl -n otel-demo get hpa $h -o json | python3 -I -c '\nimport sys,json\nh=json.load(sys.stdin)\nfor m in h[\"spec\"][\"metrics\"]:\n    if m[\"resource\"][\"name\"]==\"memory\": m[\"resource\"][\"target\"][\"averageUtilization\"]=200\nprint(json.dumps({\"spec\":{\"metrics\":h[\"spec\"][\"metrics\"]}}))' > /tmp/p-$h.json; kubectl -n otel-demo patch hpa $h --type merge --patch-file /tmp/p-$h.json; done\nsleep 60; kubectl -n otel-demo get hpa | awk '$1~/^(ad|fraud-detection|kafka|frontend|image-provider)$/'",
      "cd /tmp; for h in ad fraud-detection kafka frontend image-provider; do kubectl -n otel-demo get hpa $h -o jsonpath='{.spec.metrics[*].resource.name}'; echo; done",
      "cd /tmp; for h in ad fraud-detection kafka frontend image-provider; do kubectl -n otel-demo patch hpa $h --type json -p '[{\"op\":\"replace\",\"path\":\"/spec/metrics/1/resource/target/averageUtilization\",\"value\":200}]'; done; kubectl -n otel-demo get hpa | awk '$1~/^(ad|fraud-detection|kafka|frontend|image-provider)$/'"

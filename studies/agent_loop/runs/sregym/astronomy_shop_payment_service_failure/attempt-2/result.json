{
  "agent": {
    "commands": [
      "kubectl get pods -n astronomy-shop | grep -v Running; kubectl get events -n astronomy-shop --sort-by=.lastTimestamp | tail -15",
      "kubectl get pods -n astronomy-shop; kubectl get deploy payment flagd -n astronomy-shop -o yaml | grep -n -i -E \"image:|name:|value:|generation|rollout\" | head -60",
      "cd /tmp; kubectl logs -n astronomy-shop deploy/product-catalog --tail=20; kubectl logs -n astronomy-shop deploy/product-catalog --previous --tail=10; kubectl get cm -n astronomy-shop flagd-config -o yaml | grep -B2 -A8 '\"defaultVariant\"' | grep -E 'defaultVariant|^\\s+\"[a-zA-Z]+\": \\{' | head -40",
      "cd /tmp; kubectl get cm -n astronomy-shop flagd-config -o json | python3 -I -c '\nimport json,sys\ncm=json.load(sys.stdin)\nfor k,v in cm[\"data\"].items():\n    d=json.loads(v)\n    for n,f in d[\"flags\"].items():\n        if f[\"defaultVariant\"]!=\"off\": print(k,n,f[\"defaultVariant\"])\n    d[\"flags\"][\"paymentFailure\"][\"defaultVariant\"]=\"off\"\n    cm[\"data\"][k]=json.dumps(d,indent=2)\njson.dump(cm,open(\"/tmp/cm.json\",\"w\"))\n'; kubectl apply -f /tmp/cm.json && kubectl rollout restart deploy/flagd -n astronomy-shop && kubectl rollout status deploy/flagd -n astronomy-shop",
      "cd /tmp; kubectl get cm -n astronomy-shop flagd-config -o yaml | grep -n -A12 '\"paymentFailure\"'",
      "cd /tmp; kubectl get cm -n astronomy-shop flagd-config -o yaml > /tmp/cm.yaml; sed -i '100s/\"100%\"/\"off\"/' /tmp/cm.yaml; sed -n 100p /tmp/cm.yaml; kubectl apply -f /tmp/cm.yaml && kubectl rollout restart deploy/flagd -n astronomy-shop && kubectl rollout status deploy/flagd -n astronomy-shop"
    ],

  "agent": {
    "commands": [
      "kubectl get pods -n astronomy-shop | grep -v Running; kubectl get events -n astronomy-shop --sort-by=.lastTimestamp | tail -15",
      "cd /tmp; kubectl get pods -n astronomy-shop; kubectl get deploy -n astronomy-shop; kubectl get cm flagd-config -n astronomy-shop -o yaml | head -80",
      "cd /tmp; kubectl get cm flagd-config -n astronomy-shop -o json | python3 -c \"\nimport json,sys\nd=json.load(sys.stdin)\nk='demo.flagd.json'\nf=json.loads(d['data'][k])\nf['flags']['productCatalogFailure']['defaultVariant']='off'\nprint(json.dumps({'data':{k:json.dumps(f,indent=2)}}))\" > /tmp/p.json\nkubectl patch cm flagd-config -n astronomy-shop --patch-file /tmp/p.json\nkubectl rollout restart deploy/flagd -n astronomy-shop; kubectl rollout status deploy/flagd -n astronomy-shop",
      "cd /tmp; kubectl get cm flagd-config -n astronomy-shop -o yaml > cm.yaml\ngrep -n -A8 '\"productCatalogFailure\"' cm.yaml | grep defaultVariant",
      "cd /tmp; kubectl get deploy flagd -n astronomy-shop -o yaml | grep -n -i -B2 -A6 'configmap\\|emptyDir\\|init-config' | head -60",
      "cd /tmp; sed -i '32s/\"on\"/\"off\"/' cm.yaml; kubectl apply -f cm.yaml -n astronomy-shop; kubectl rollout restart deploy/flagd -n astronomy-shop; kubectl rollout status deploy/flagd -n astronomy-shop; kubectl rollout restart deploy/product-catalog -n astronomy-shop; kubectl get cm flagd-config -n astronomy-shop -o yaml | grep -A8 '\"productCatalogFailure\"' | grep defaultVariant"

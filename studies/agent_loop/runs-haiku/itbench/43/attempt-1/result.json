      "kubectl -n otel-demo get pods -o wide; echo ---; kubectl -n otel-demo get events --sort-by=.lastTimestamp | tail -40",
      "kubectl -n otel-demo get deploy,svc,configmap -o wide 2>&1 | head -80",
      "cd /tmp; kubectl -n otel-demo logs deploy/frontend-proxy --tail=40 2>&1; echo ---FRONTEND; kubectl -n otel-demo logs deploy/frontend --tail=60 2>&1; echo ---HISTORY; kubectl -n otel-demo rollout history deploy/frontend 2>&1",
      "cd /tmp; kubectl -n otel-demo get deploy frontend -o yaml 2>&1 | head -150; echo ---OLD RS; kubectl -n otel-demo get rs -l opentelemetry.io/name=frontend -o wide 2>&1",
      "cd /tmp; kubectl -n otel-demo get rs frontend-ffb4447db -o jsonpath='{.spec.template.spec.dnsPolicy}{\"\\n\"}' ; kubectl -n otel-demo get rs frontend-5b855dcf7c -o jsonpath='{.spec.template.spec.dnsPolicy}{\"\\n\"}'; kubectl -n otel-demo get rs frontend-ffb4447db -o yaml | diff - <(kubectl -n otel-demo get rs frontend-5b855dcf7c -o yaml) | head -60; echo ---; kubectl -n otel-demo exec deploy/frontend -- cat /etc/resolv.conf 2>&1; echo ---; kubectl -n otel-demo get pods -l opentelemetry.io/name=frontend -o jsonpath='{.items[0].spec.dnsPolicy}{\"\\n\"}'",
      "cd /tmp; kubectl -n otel-demo patch deploy frontend --type=merge -p '{\"spec\":{\"template\":{\"spec\":{\"dnsPolicy\":\"ClusterFirst\"}}}}' && kubectl -n otel-demo rollout status deploy/frontend --timeout=180s; kubectl -n otel-demo get pods -l opentelemetry.io/name=frontend -o jsonpath='{.items[*].spec.dnsPolicy}{\"\\n\"}'",
      "cd /tmp; sleep 30; NEW=$(kubectl -n otel-demo get pods -l opentelemetry.io/name=frontend -o jsonpath='{.items[0].metadata.name}'); echo \"pod=$NEW\"; kubectl -n otel-demo logs \"$NEW\" --since=60s 2>&1 | grep -c \"Name resolution failed\"; kubectl -n otel-demo logs \"$NEW\" --since=60s 2>&1 | grep -c '\"http.response.status_code\":500'; kubectl -n otel-demo logs deploy/frontend-proxy --since=60s 2>&1 | grep -E ' (5[0-9]{2}) ' | tail -5; echo ---; kubectl -n otel-demo run dnscheck --rm -i --restart=Never --image=busybox:1.36 -- nslookup cart.otel-demo.svc.cluster.local 2>&1 | tail -5; echo ---; kubectl -n otel-demo get pods 2>&1 | grep -v Running",
      "cd /tmp; kubectl -n otel-demo logs deploy/frontend-proxy --since=90s 2>&1 | tail -5; echo ---; kubectl -n otel-demo logs deploy/frontend-proxy --since=90s 2>&1 | grep -oE 'HTTP/[0-9.]\" [0-9]{3}|\" [0-9]{3} ' | sort | uniq -c",
      "cd /tmp; kubectl -n otel-demo run probe --rm -i --restart=Never --image=busybox:1.36 -- sh -c 'for p in / /api/products /api/data /api/cart; do wget -S -O /dev/null -T 10 http://frontend-proxy:8080$p 2>&1 | grep -m1 \"HTTP/\"; done' 2>&1 | grep -v -E 'session|command|prompt|pod \"probe\"'",
      "cd /tmp; for p in / /api/products /api/data /api/cart; do echo \"== $p\"; kubectl -n otel-demo run probe-$RANDOM --rm -i --restart=Never --quiet --image=busybox:1.36 -- wget -S -O /dev/null -T 10 http://frontend-proxy:8080$p 2>&1 | grep -E 'HTTP/|wget:' | head -2; done"

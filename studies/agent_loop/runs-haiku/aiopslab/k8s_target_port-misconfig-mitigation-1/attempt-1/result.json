      "cd /tmp; kubectl get endpoints -n test-social-network user-service compose-post-service social-graph-service 2>&1; echo \"---SVC user-service---\"; kubectl get svc user-service -n test-social-network -o yaml 2>&1 | grep -A12 -E 'spec:'; echo \"---POD LABELS---\"; kubectl get pods -n test-social-network --show-labels 2>&1 | grep -E 'user-service|compose'; echo \"---CONNECT---\"; kubectl exec -n test-social-network deploy/compose-post-service -- sh -c 'timeout 3 bash -c \"echo > /dev/tcp/user-service/9090\" && echo OK || echo FAIL' 2>&1",

      "cd /tmp; POD=$(kubectl get pod -n test-hotel-reservation -l io.kompose.service=mongodb-geo -o jsonpath='{.items[0].metadata.name}'); echo \"pod=$POD\"; kubectl exec -n test-hotel-reservation \"$POD\" -- mongo admin -u root -p root --authenticationDatabase admin --quiet --eval \"printjson(db.getUser('admin'))\" 2>&1 | head -40",
      "cd /tmp; POD=mongodb-geo-5ff578bcb8-5zm6t; kubectl exec -n test-hotel-reservation \"$POD\" -- mongo admin -u root -p root --authenticationDatabase admin --quiet --eval \"db.grantRolesToUser('admin', [{role: 'readWrite', db: 'geo-db'}]); printjson(db.getUser('admin').roles)\" 2>&1",

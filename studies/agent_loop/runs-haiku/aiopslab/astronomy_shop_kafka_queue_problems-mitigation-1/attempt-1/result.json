      "mkdir -p /tmp/flagd-fix && cd /tmp/flagd-fix && kubectl -n astronomy-shop get configmap flagd-config -o jsonpath='{.data.demo\\.flagd\\.json}' > original.flagd.json && sed '/\"kafkaQueueProblems\"/,/\"description\"/!b' original.flagd.json >/dev/null; awk 'BEGIN{f=0} /\"kafkaQueueProblems\": \\{/{f=1} f && /\"defaultVariant\": \"on\"/{sub(/\"on\"/,\"\\\"off\\\"\"); f=0} {print}' original.flagd.json > patched.flagd.json && diff original.flagd.json patched.flagd.json; echo \"exit=$?\"",

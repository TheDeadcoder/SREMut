      "kubectl get jobs,cronjobs -n test-hotel-reservation 2>&1; echo ---; POD=$(kubectl get pod -n test-hotel-reservation -l io.kompose.service=mongodb-rate -o jsonpath='{.items[0].metadata.name}'); echo $POD; kubectl exec -n test-hotel-reservation $POD -- mongo admin -u admin -p admin --authenticationDatabase admin --quiet --eval \"printjson(db.getUser('admin'))\" 2>&1 | head -40; echo ---; kubectl exec -n test-hotel-reservation $POD -- mongo admin -u root -p root --authenticationDatabase admin --quiet --eval \"printjson(db.getUser('root'))\" 2>&1 | head -40",
      "POD=$(kubectl get pod -n test-hotel-reservation -l io.kompose.service=mongodb-rate -o jsonpath='{.items[0].metadata.name}'); kubectl exec -n test-hotel-reservation $POD -- mongo admin -u root -p root --authenticationDatabase admin --quiet --eval \"db.grantRolesToUser('admin', [{role: 'readWrite', db: 'rate-db'}]); printjson(db.getUser('admin').roles)\" 2>&1",

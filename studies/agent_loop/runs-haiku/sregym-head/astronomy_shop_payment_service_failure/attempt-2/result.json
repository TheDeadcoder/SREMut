{
  "agent": {
    "commands": [
      "kubectl -n astronomy-shop get pods -o wide; echo ---; kubectl -n astronomy-shop get events --sort-by=.lastTimestamp | tail -40",
      "cd /tmp; for d in payment flagd; do echo \"=== $d rollout history\"; kubectl -n astronomy-shop rollout history deploy/$d; done; echo; kubectl -n astronomy-shop get deploy payment flagd -o yaml | grep -vE 'creationTimestamp|resourceVersion|uid:|generation|managedFields' | head -300",
      "cd /tmp; kubectl -n astronomy-shop logs deploy/payment --tail=30; echo \"=== flagd\"; kubectl -n astronomy-shop logs deploy/flagd -c flagd --tail=30; echo \"=== checkout\"; kubectl -n astronomy-shop logs deploy/checkout --tail=15; echo \"=== svc\"; kubectl -n astronomy-shop get svc; echo \"=== cm\"; kubectl -n astronomy-shop get cm flagd-config -o yaml | head -150",
      "cd /tmp; kubectl -n astronomy-shop get cm flagd-config -o jsonpath='{.data.demo\\.flagd\\.json}' | grep -n -E '\"defaultVariant\"|\"state\"' ; echo \"=== payment errors\"; kubectl -n astronomy-shop logs deploy/payment --tail=300 2>/dev/null | grep -iE 'error|fail|exception' | tail -10; echo \"=== kubectl describe cm metadata\"; kubectl -n astronomy-shop get cm flagd-config -o jsonpath='{.metadata.annotations}{\"\\n\"}{.metadata.managedFields[*].manager}{\"\\n\"}'",
      "mkdir -p /tmp/fix && cd /tmp/fix && kubectl -n astronomy-shop get cm flagd-config -o jsonpath='{.data.demo\\.flagd\\.json}' | sed 's/\"defaultVariant\": \"100%\"/\"defaultVariant\": \"off\"/' > demo.flagd.json && grep -n '\"100%\"' demo.flagd.json; kubectl -n astronomy-shop create cm flagd-config --from-file=demo.flagd.json=/tmp/fix/demo.flagd.json --dry-run=client -o yaml | kubectl -n astronomy-shop replace -f - && kubectl -n astronomy-shop get cm flagd-config -o jsonpath='{.data.demo\\.flagd\\.json}' | grep -A4 '\"paymentFailure\"'",
      "cd /tmp; kubectl -n astronomy-shop get cm flagd-config -o jsonpath='{.data.demo\\.flagd\\.json}' | grep -A8 '\"paymentFailure\"' | grep defaultVariant; kubectl -n astronomy-shop rollout restart deploy/flagd && kubectl -n astronomy-shop rollout status deploy/flagd --timeout=180s && kubectl -n astronomy-shop get pods | grep -E 'flagd|payment'",
      "cd /tmp; kubectl -n astronomy-shop exec deploy/flagd -c flagd -- cat /etc/flagd/demo.flagd.json | python3 -c 'import json,sys; print(json.load(sys.stdin)[\"flags\"][\"paymentFailure\"][\"defaultVariant\"])' 2>/dev/null || kubectl -n astronomy-shop exec deploy/flagd -c flagd -- cat /etc/flagd/demo.flagd.json | grep -A12 '\"paymentFailure\"' | grep defaultVariant; kubectl -n astronomy-shop get pods | grep -E 'flagd|payment'",
      "cd /tmp; kubectl -n astronomy-shop logs deploy/flagd -c init-config | grep -A12 '\"paymentFailure\"' | grep defaultVariant; kubectl -n astronomy-shop logs deploy/flagd -c flagd --tail=3"
    ],
    "exit_code": 0,
    "image": "sremut-agent:k8s-1.32",
    "is_error": false,

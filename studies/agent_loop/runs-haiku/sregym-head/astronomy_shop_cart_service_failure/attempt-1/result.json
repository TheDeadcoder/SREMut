      "cd /tmp; NS=astronomy-shop; kubectl -n $NS logs deploy/checkout --since=10m 2>&1 | grep -iE \"error|fail|cart\" | tail -8; echo \"--- frontend\"; kubectl -n $NS logs deploy/frontend --since=10m 2>&1 | grep -iE \"error|cart\" | tail -5; echo \"--- cart errors\"; kubectl -n $NS logs deploy/cart --since=10m 2>&1 | grep -iE \"error|exception|fail\" | tail -5",
      "mkdir -p /tmp/fix-flagd && cd /tmp/fix-flagd && NS=astronomy-shop && kubectl -n $NS get cm flagd-config -o jsonpath='{.data.demo\\.flagd\\.json}' > demo.flagd.json && python3 -I -c '\nimport json,sys\np=\"/tmp/fix-flagd/demo.flagd.json\"\nd=json.load(open(p))\nf=d[\"flags\"][\"cartFailure\"]\nassert f[\"defaultVariant\"]==\"on\", f\nf[\"defaultVariant\"]=\"off\"\njson.dump(d,open(p,\"w\"),indent=2)\nopen(p,\"a\").write(\"\\n\")\nprint(\"patched cartFailure ->\", f[\"defaultVariant\"])\n' && kubectl -n $NS create cm flagd-config --from-file=demo.flagd.json=/tmp/fix-flagd/demo.flagd.json --dry-run=client -o yaml | kubectl -n $NS apply -f - && kubectl -n $NS get cm flagd-config -o jsonpath='{.data.demo\\.flagd\\.json}' | grep -A7 '\"cartFailure\"'",

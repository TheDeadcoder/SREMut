      "cd /tmp; kubectl -n astronomy-shop get rs 2>&1 | grep -E 'cart|flagd'; echo; kubectl -n astronomy-shop rollout history deploy/cart 2>&1; kubectl -n astronomy-shop rollout history deploy/flagd 2>&1; echo; kubectl -n astronomy-shop get svc 2>&1; echo; kubectl -n astronomy-shop get endpoints 2>&1 | head -50",

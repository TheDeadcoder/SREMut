      "cd /tmp; kubectl create configmap flagd-config -n astronomy-shop --from-file=demo.flagd.json=/tmp/flagd-current.json --dry-run=client -o yaml | kubectl apply -n astronomy-shop -f - 2>&1; kubectl rollout restart deploy/flagd -n astronomy-shop 2>&1; kubectl rollout status deploy/flagd -n astronomy-shop --timeout=180s 2>&1; kubectl get cm flagd-config -n astronomy-shop -o jsonpath='{.data.demo\\.flagd\\.json}' | grep -n -A6 '\"cartFailure\"'",

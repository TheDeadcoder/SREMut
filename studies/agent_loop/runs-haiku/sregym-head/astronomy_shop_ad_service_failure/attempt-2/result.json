      "cd /tmp; for p in ad-84c8d9ff69-h2lp8 flagd-7644bd675c-sw5dp; do echo \"== $p\"; kubectl -n astronomy-shop logs $p -c ${p%%-*} --tail=40 2>&1; done; kubectl -n astronomy-shop logs deploy/flagd -c flagd --tail=40 2>&1",
      "cd /tmp; kubectl -n astronomy-shop get cm flagd-config -o json | python3 -I -c '\nimport json,sys\ncm=json.load(sys.stdin)\ncfg=json.loads(cm[\"data\"][\"demo.flagd.json\"])\ncfg[\"flags\"][\"adFailure\"][\"defaultVariant\"]=\"off\"\ncm[\"data\"][\"demo.flagd.json\"]=json.dumps(cfg,indent=2)+\"\\n\"\nfor k in [\"resourceVersion\",\"uid\",\"creationTimestamp\",\"managedFields\",\"generation\"]:\n    cm[\"metadata\"].pop(k,None)\njson.dump(cm,sys.stdout)' > /tmp/flagd-config-fixed.json && kubectl -n astronomy-shop apply -f /tmp/flagd-config-fixed.json && kubectl -n astronomy-shop rollout restart deploy/flagd && kubectl -n astronomy-shop rollout status deploy/flagd --timeout=180s && kubectl -n astronomy-shop get cm flagd-config -o jsonpath='{.data.demo\\.flagd\\.json}' | grep -A4 '\"adFailure\"'",
      "mkdir -p /tmp/flagd-fix && cd /tmp/flagd-fix && kubectl -n astronomy-shop get cm flagd-config -o jsonpath='{.data.demo\\.flagd\\.json}' > demo.flagd.json && grep -n -A8 '\"adFailure\"' demo.flagd.json",
      "sed -i '65s/\"defaultVariant\": \"on\"/\"defaultVariant\": \"off\"/' demo.flagd.json && sed -n '58,66p' demo.flagd.json && kubectl -n astronomy-shop create cm flagd-config --from-file=demo.flagd.json --dry-run=client -o yaml | kubectl -n astronomy-shop apply -f - && kubectl -n astronomy-shop rollout restart deploy/flagd && kubectl -n astronomy-shop rollout status deploy/flagd --timeout=180s && kubectl -n astronomy-shop get cm flagd-config -o jsonpath='{.data.demo\\.flagd\\.json}' | grep -A7 '\"adFailure\"'",

  "agent": {
    "commands": [
      "kubectl -n astronomy-shop get pods -o wide 2>&1 | head -100",
      "kubectl -n astronomy-shop get events --sort-by=.lastTimestamp 2>&1 | tail -50",
      "kubectl -n astronomy-shop rollout history deployment/ad 2>&1; kubectl -n astronomy-shop rollout history deployment/flagd 2>&1; kubectl -n astronomy-shop get deployment ad -o yaml 2>&1 | head -150",
      "kubectl -n astronomy-shop get deployment flagd -o yaml 2>&1 | head -200; kubectl -n astronomy-shop get configmap -o name 2>&1",
      "kubectl -n astronomy-shop get configmap flagd-config -o yaml 2>&1 | head -300",
      "kubectl -n astronomy-shop logs deploy/ad --tail=40 2>&1; echo ---; kubectl -n astronomy-shop logs deploy/flagd -c flagd --tail=40 2>&1",
      "kubectl -n astronomy-shop get configmap flagd-config -o json > /tmp/flagd-config.json && python3 -I -c '\nimport json\np=\"/tmp/flagd-config.json\"\ncm=json.load(open(p))\nflags=json.loads(cm[\"data\"][\"demo.flagd.json\"])\nflags[\"flags\"][\"adHighCpu\"][\"defaultVariant\"]=\"off\"\ncm[\"data\"][\"demo.flagd.json\"]=json.dumps(flags,indent=2)+\"\\n\"\njson.dump(cm,open(p,\"w\"))\nprint(\"adHighCpu ->\", flags[\"flags\"][\"adHighCpu\"][\"defaultVariant\"])\n' && kubectl -n astronomy-shop replace -f /tmp/flagd-config.json && kubectl -n astronomy-shop rollout restart deployment/flagd && kubectl -n astronomy-shop rollout status deployment/flagd --timeout=180s",
      "kubectl -n astronomy-shop get configmap flagd-config -o yaml > /tmp/flagd-config.yaml && grep -n '\"defaultVariant\": \"on\"' /tmp/flagd-config.yaml; grep -n -A3 '\"adHighCpu\"' /tmp/flagd-config.yaml",
      "sed -i '59s/\"defaultVariant\": \"on\"/\"defaultVariant\": \"off\"/' /tmp/flagd-config.yaml && sed -n '52,60p' /tmp/flagd-config.yaml && kubectl -n astronomy-shop replace -f /tmp/flagd-config.yaml && kubectl -n astronomy-shop rollout restart deployment/flagd && kubectl -n astronomy-shop rollout status deployment/flagd --timeout=180s",
      "kubectl -n astronomy-shop exec deploy/flagd -c flagd -- sh -c 'grep -A8 \"\\\"adHighCpu\\\"\" /etc/flagd/demo.flagd.json | grep defaultVariant' 2>&1; kubectl -n astronomy-shop rollout restart deployment/ad && kubectl -n astronomy-shop rollout status deployment/ad --timeout=180s && sleep 30 && kubectl -n astronomy-shop logs deploy/ad --tail=200 2>&1 | grep -c \"High CPU-Load problempattern enabled\"; kubectl -n astronomy-shop get pods 2>&1 | grep -E 'ad-|flagd-'",
      "kubectl -n astronomy-shop logs deploy/flagd -c init-config 2>&1 | grep -A8 '\"adHighCpu\"' | grep defaultVariant; kubectl -n astronomy-shop logs deploy/ad --tail=15 2>&1 | grep -E 'request|problempattern' ; echo; kubectl -n astronomy-shop get pods 2>&1 | grep -vE 'Running' ; echo \"non-running check done\""

      "cd /tmp; kubectl top pods -n astronomy-shop 2>&1 | head -40; echo ---; kubectl logs deploy/ad -n astronomy-shop --tail=10 2>&1; echo ---; kubectl get deploy flagd -n astronomy-shop -o jsonpath='{.spec.template.spec.initContainers[*].command}{\"\\n\"}{.spec.template.spec.volumes}' 2>&1",
      "cd /tmp; kubectl get cm flagd-config -n astronomy-shop -o json | python3 -I -c '\nimport json,sys\ncm=json.load(sys.stdin)\nf=json.loads(cm[\"data\"][\"demo.flagd.json\"])\nf[\"flags\"][\"adHighCpu\"][\"defaultVariant\"]=\"off\"\ncm[\"data\"][\"demo.flagd.json\"]=json.dumps(f,indent=2)\nfor k in [\"resourceVersion\",\"uid\",\"creationTimestamp\",\"managedFields\"]: cm[\"metadata\"].pop(k,None)\ncm[\"metadata\"].pop(\"annotations\",None)\nprint(json.dumps(cm))' > /tmp/flagd-config-fixed.json && kubectl apply -f /tmp/flagd-config-fixed.json 2>&1 && kubectl get cm flagd-config -n astronomy-shop -o jsonpath='{.data.demo\\.flagd\\.json}' | grep -A6 '\"adHighCpu\"'",
      "cd /tmp; kubectl get cm flagd-config -n astronomy-shop -o yaml > /tmp/flagd-config.yaml && grep -n '\"defaultVariant\": \"on\"' /tmp/flagd-config.yaml && sed -i 's/\"defaultVariant\": \"on\"/\"defaultVariant\": \"off\"/' /tmp/flagd-config.yaml && kubectl replace -f /tmp/flagd-config.yaml 2>&1 && kubectl get cm flagd-config -n astronomy-shop -o jsonpath='{.data.demo\\.flagd\\.json}' | grep -A7 '\"adHighCpu\"'",

      "cd /tmp; kubectl get deploy -n astronomy-shop -o custom-columns=NAME:.metadata.name,IMAGE:.spec.template.spec.containers[*].image,REPLICAS:.spec.replicas,AVAIL:.status.availableReplicas 2>&1; echo ---; kubectl get cm -n astronomy-shop 2>&1; echo ---; kubectl rollout history deploy/flagd -n astronomy-shop 2>&1; kubectl rollout history deploy/ad -n astronomy-shop 2>&1",
